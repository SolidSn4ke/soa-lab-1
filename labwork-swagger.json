        "/labworks/op/sum": {
            "get": {
                "summary": "Рассчитать сумму значений поля minimalPoint",
                "description": "Возвращает сумму значений поля minimalPoint для всех объектов коллекции",
                "parameters": [
                    {
                        "name": "field",
                        "in": "query",
                        "description": "Поле для расчета суммы.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "minimalPoint"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
