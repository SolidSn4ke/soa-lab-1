        "/labworks": {
            "get": {
                "summary": "Получить список элементов коллекции LabWork",
                "description": "Получить список элементов коллекции LabWork c пагинацией, сортировкой и фильтрацией",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Номер страницы",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "minimum": 0,
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Количество элементов на странице",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "minimum": 1,
                            "default": 20
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Список полей для сортировки в формате 'field,asc|desc;'",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "name,asc;minimalPoint,desc"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Строка для построения фильтра. Для чисел разрешены фильтры: >, <, >=, <=, =; Для строк разрешены фильтры =, ~",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "name=abc;minimalPoint>3"
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageInfo"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректные параметры запроса",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/ErrorMsg"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера"
                    }
                }
            },
            "post": {
                "summary": "Создать LabWork",
                "description": "Создать в системе новую Лабораторную работу",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "coordinates": {
                                        "$ref": "#/components/schemas/Coordinates"
                                    },
                                    "minimalPoint": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1
                                    },
                                    "averagePoint": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1
                                    },
                                    "difficulty": {
                                        "$ref": "#/components/schemas/Difficulty"
                                    },
                                    "disciplineId": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/LabWork"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректное тело запроса",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/ErrorMsg"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Конфликт",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
