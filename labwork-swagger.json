    "components": {
        "schemas": {
            "PageInfo": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer",
                        "format": "int32",
                        "minimum": 0,
                        "default": 0
                    },
                    "totalPages": {
                        "type": "integer",
                        "format": "int32",
                        "minimum": 1
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32",
                        "minimum": 1,
                        "default": 20
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int32",
                        "minimum": 1
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LabWork"
                        }
                    }
                }
            },
            "LabWork": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "coordinates",
                    "creationDate",
                    "minimalPoint",
                    "discipline"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Поле не может быть null, Значение поля должно быть больше 0, Значение этого поля должно быть уникальным, Значение этого поля должно генерироваться автоматически",
                        "minimum": 1,
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "description": "Поле не может быть null, Строка не может быть пустой",
                        "minLength": 1
                    },
                    "coordinates": {
                        "$ref": "#/components/schemas/Coordinates"
                    },
                    "creationDate": {
                        "type": "string",
                        "format": "date",
                        "description": "Поле не может быть null, Значение этого поля должно генерироваться автоматически",
                        "readOnly": true
                    },
                    "minimalPoint": {
                        "type": "number",
                        "format": "float",
                        "description": "Поле не может быть null, Значение поля должно быть больше 0",
                        "minimum": 0,
                        "exclusiveMinimum": true
                    },
                    "averagePoint": {
                        "type": "number",
                        "format": "float",
                        "description": "Поле может быть null, Значение поля должно быть больше 0",
                        "minimum": 0,
                        "exclusiveMinimum": true,
                        "nullable": true
                    },
                    "difficulty": {
                        "$ref": "#/components/schemas/Difficulty"
                    },
                    "discipline": {
                        "$ref": "#/components/schemas/Discipline"
                    }
                }
            },
            "Coordinates": {
                "type": "object",
                "required": [
                    "x",
                    "y"
                ],
                "properties": {
                    "x": {
                        "type": "number",
                        "format": "float",
                        "description": "Значение поля должно быть больше -719, Поле не может быть null",
                        "minimum": -719,
                        "exclusiveMinimum": true
                    },
                    "y": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Поле не может быть null"
                    }
                }
            },
            "Discipline": {
                "type": "object",
                "required": [
                    "name",
                    "labsCount"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Поле не может быть null, Строка не может быть пустой",
                        "minLength": 1
                    },
                    "labsCount": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Поле не может быть null"
                    }
                }
            },
            "Difficulty": {
                "type": "string",
                "enum": [
                    "EASY",
                    "HARD",
                    "TERRIBLE"
                ],
                "nullable": true
            },
            "ErrorMsg": {
                "type": "object",
                "properties": {
                    "msg": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}